<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong · Melocoton</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #ffffff;
        color: #1a1a18;
      }

      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
        background:
          radial-gradient(circle at top, rgba(253, 79, 0, 0.08), transparent 38%),
          #ffffff;
      }

      main {
        box-sizing: border-box;
        width: min(38rem, calc(100% - 2rem));
        padding: 2.5rem;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.88);
        box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.08);
        text-align: center;
      }

      .mark {
        display: grid;
        width: 3rem;
        height: 3rem;
        margin: 0 auto 1.25rem;
        place-items: center;
        border-radius: 0.875rem;
        background: rgba(253, 79, 0, 0.12);
        color: #fd4f00;
        font-size: 1.5rem;
        font-weight: 700;
      }

      .code {
        margin: 0 0 0.5rem;
        color: #78716c;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(1.5rem, 5vw, 2rem);
        line-height: 1.2;
      }

      p {
        margin: 1rem auto 1.5rem;
        color: #57534e;
        line-height: 1.6;
      }

      details {
        margin: 0 0 1.5rem;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 0.75rem;
        background: rgba(0, 0, 0, 0.025);
        text-align: left;
      }

      summary {
        padding: 0.875rem 1rem;
        cursor: pointer;
        color: #57534e;
        font-size: 0.875rem;
        font-weight: 600;
      }

      .diagnostics {
        padding: 0 1rem 1rem;
      }

      .diagnostics p {
        margin: 0 0 0.75rem;
        font-size: 0.8125rem;
      }

      pre {
        overflow: auto;
        margin: 0;
        padding: 0.875rem;
        border-radius: 0.5rem;
        background: #f5f5f4;
        color: #1a1a18;
        font: 0.75rem/1.55 "SFMono-Regular", Consolas, monospace;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        justify-content: center;
      }

      a,
      button {
        display: inline-flex;
        box-sizing: border-box;
        min-height: 2.75rem;
        padding: 0 1.125rem;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0, 0, 0, 0.14);
        border-radius: 0.625rem;
        background: transparent;
        color: inherit;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      a:hover,
      button:hover {
        background: rgba(0, 0, 0, 0.05);
      }

      .primary {
        border-color: #fd4f00;
        background: #fd4f00;
        color: #ffffff;
      }

      .primary:hover {
        background: #e64700;
      }

      a:focus-visible,
      button:focus-visible,
      summary:focus-visible {
        outline: 3px solid rgba(253, 79, 0, 0.35);
        outline-offset: 3px;
      }

      .copy-status {
        min-height: 1.25rem;
        margin: 0.75rem 0 0;
        color: #15803d;
        font-size: 0.8125rem;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          background: #1c1c1a;
          color: #f5f5f0;
        }

        body {
          background:
            radial-gradient(circle at top, rgba(253, 79, 0, 0.12), transparent 38%),
            #1c1c1a;
        }

        main {
          border-color: rgba(255, 255, 255, 0.1);
          background: rgba(36, 36, 34, 0.92);
          box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.3);
        }

        .code,
        p,
        summary {
          color: #a8a29e;
        }

        details {
          border-color: rgba(255, 255, 255, 0.1);
          background: rgba(255, 255, 255, 0.025);
        }

        pre {
          background: #1c1c1a;
          color: #f5f5f0;
        }

        a,
        button {
          border-color: rgba(255, 255, 255, 0.14);
        }

        a:hover,
        button:hover {
          background: rgba(255, 255, 255, 0.06);
        }

        .primary {
          border-color: #fd4f00;
          background: #fd4f00;
        }

        .primary:hover {
          background: #e64700;
        }

        .copy-status {
          color: #86efac;
        }
      }
    </style>
  </head>
  <body>
    <% diagnostics = diagnostic_report(@kind, @reason, @stack) %>
    <main>
      <div class="mark" aria-hidden="true">!</div>
      <div class="code">Error 500</div>
      <h1>Something went wrong</h1>
      <p>
        Melocoton ran into an unexpected error. You can safely return home and try again. If the
        problem continues, send the diagnostic report to {diagnostics.support_email}.
      </p>

      <details>
        <summary>Review diagnostic report</summary>
        <div class="diagnostics">
          <p>
            This report includes the stack trace, but excludes error messages, database queries, and
            credentials.
          </p>
          <pre id="diagnostic-report">{diagnostics.report}</pre>
        </div>
      </details>

      <div class="actions">
        <button id="copy-diagnostics" type="button">Copy diagnostics</button>
        <a href={diagnostics.mailto}>Email support</a>
        <a class="primary" href="/">Go to home</a>
      </div>
      <div id="copy-status" class="copy-status" role="status" aria-live="polite"></div>
    </main>

    <script>
      (function () {
        var button = document.getElementById("copy-diagnostics");
        var report = document.getElementById("diagnostic-report");
        var status = document.getElementById("copy-status");

        function copied() {
          button.textContent = "Copied";
          status.textContent = "Diagnostic report copied to the clipboard.";
          window.setTimeout(function () {
            button.textContent = "Copy diagnostics";
            status.textContent = "";
          }, 3000);
        }

        function fallbackCopy(text) {
          var textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          textarea.remove();
          copied();
        }

        button.addEventListener("click", function () {
          var text = report.textContent.trim();

          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(copied, function () {
              fallbackCopy(text);
            });
          } else {
            fallbackCopy(text);
          }
        });
      })();
    </script>
  </body>
</html>
